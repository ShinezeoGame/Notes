<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Raccourcis Ostal » : jusqu'à six raccourcis (section, nouvelle page…), choisis dans l'application
     (Réglages → Widgets du téléphone). Les emplacements sont remplis par WidgetViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="6dp"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:id="@+id/sc_slot1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <ImageView
            android:id="@+id/sc_icon1"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/widget_tile"
            android:src="@drawable/ic_w_new_page"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/sc_label1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/widget_text"
            android:text="@string/widget_sc_new_page" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sc_slot2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <ImageView
            android:id="@+id/sc_icon2"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/widget_tile"
            android:src="@drawable/ic_w_agenda"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/sc_label2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/widget_text"
            android:text="@string/widget_sc_agenda" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sc_slot3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <ImageView
            android:id="@+id/sc_icon3"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/widget_tile"
            android:src="@drawable/ic_w_papers"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/sc_label3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/widget_text"
            android:text="@string/widget_sc_papers" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sc_slot4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <ImageView
            android:id="@+id/sc_icon4"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/widget_tile"
            android:src="@drawable/ic_w_pdf"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/sc_label4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/widget_text"
            android:text="@string/widget_sc_pdf" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sc_slot5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/sc_icon5"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/widget_tile"
            android:src="@drawable/ic_w_notes"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/sc_label5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/widget_text"
            android:text="@string/widget_sc_new_page" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sc_slot6"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/sc_icon6"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/widget_tile"
            android:src="@drawable/ic_w_notes"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/sc_label6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/widget_text"
            android:text="@string/widget_sc_new_page" />
    </LinearLayout>
</LinearLayout>

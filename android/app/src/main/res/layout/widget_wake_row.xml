<?xml version="1.0" encoding="utf-8"?>
<!-- Un ordinateur du widget « Allumer l'ordinateur » : bouton rond, nom, état du dernier signal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wk_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <ImageView
        android:id="@+id/wk_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:background="@drawable/widget_power_bg"
        android:src="@drawable/ic_w_power_white"
        android:contentDescription="@null" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/wk_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text" />
        <TextView
            android:id="@+id/wk_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/widget_muted" />
    </LinearLayout>
</LinearLayout>

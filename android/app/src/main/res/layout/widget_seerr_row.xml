<?xml version="1.0" encoding="utf-8"?>
<!-- Une demande du widget « Films et séries » : titre et état (disponible, en cours…). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sr_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="34dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_w_media"
        android:contentDescription="@null" />
    <TextView
        android:id="@+id/sr_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="14sp"
        android:textColor="@color/widget_text" />
    <TextView
        android:id="@+id/sr_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/widget_accent" />
</LinearLayout>

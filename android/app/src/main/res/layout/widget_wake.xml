<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Allumer l'ordinateur » : un bouton par ordinateur réglé sur l'accueil d'Ostal (lignes : widget_wake_row.xml),
     sans barre de titre pour tenir sur une seule rangée de l'écran d'accueil. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:id="@+id/wk_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    <TextView
        android:id="@+id/wk_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textSize="13sp"
        android:textColor="@color/widget_muted"
        android:visibility="gone" />
</LinearLayout>

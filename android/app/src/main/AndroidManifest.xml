<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Atelier PDF : « Ouvrir avec Ostal » pour un PDF (Gmail, WhatsApp, Fichiers…) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- « Partager » un ou plusieurs PDF ou photos vers Ostal -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Vérification périodique des mises à jour (notification quand une version est disponible) -->
        <service
            android:name=".UpdateCheckJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Rappels (papiers, agendas) : relecture toutes les heures, alarme à l'heure de chaque rappel -->
        <service
            android:name=".ReminderJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- Widgets de l'écran d'accueil : raccourcis, tâches (relues toutes les 30 minutes), allumer l'ordinateur, films et séries -->
        <receiver
            android:name=".ShortcutsWidget"
            android:label="@string/widget_shortcuts_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_shortcuts_info" />
        </receiver>
        <receiver
            android:name=".TasksWidget"
            android:label="@string/widget_tasks_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tasks_info" />
        </receiver>
        <receiver
            android:name=".WakeWidget"
            android:label="@string/widget_wake_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_wake_info" />
        </receiver>
        <receiver
            android:name=".SeerrWidget"
            android:label="@string/widget_seerr_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_seerr_info" />
        </receiver>
        <!-- « + » du widget Tâches : petite fenêtre par-dessus l'écran d'accueil, hors de la liste des applications récentes -->
        <activity
            android:name=".TaskAddActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Barre de recherche du widget « Films et séries » : même genre de fenêtre -->
        <activity
            android:name=".SeerrSearchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notification de mise à jour disponible (Android 13+ : autorisation demandée par l'application) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Conserver la vérification périodique des mises à jour après un redémarrage du téléphone -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Vérification « avec réseau » (JobScheduler) : obligatoire à partir d'Android 14, sinon refus (SecurityException) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Rappels à l'heure exacte (agenda, échéances des papiers) : accordé à l'installation (Android 12 : SCHEDULE ;
         Android 13 et suivants : USE, réservé aux applications d'agenda et de rappels) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
</manifest>

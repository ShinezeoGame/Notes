{
  "name": "Notes",
  "short_name": "Notes",
  "description": "Pages et notes, agenda, homelab, maison connectée et atelier PDF, synchronisés avec votre serveur Notes.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#191919",
  "theme_color": "#191919",
  "lang": "fr",
  "dir": "ltr",
  "categories": ["productivity"],
  "icons": [
    { "src": "icons/notes-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/notes-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/notes-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Maison connectée", "short_name": "Maison", "url": "./#/maison" },
    { "name": "Homelab", "url": "./#/dashboard" },
    { "name": "Atelier PDF", "short_name": "PDF", "url": "./#/pdf" }
  ],
  "file_handlers": [{ "action": "./", "accept": { "application/pdf": [".pdf"] }, "launch_type": "single-client" }]
}

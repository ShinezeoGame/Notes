# Copiez ce fichier en .env puis adaptez les valeurs.

# Accès depuis Internet : « tunnel » (Cloudflare Tunnel), « caddy » (Caddy + ports 80/443), ou vide.
COMPOSE_PROFILES=tunnel

# Adresse publique HTTPS de l'application, sans / final.
PUBLIC_URL=https://notes.mondomaine.fr

# Nombre maximal d'espaces de travail. 1 = seul le vôtre (recommandé sur Internet).
MAX_WORKSPACES=1

# Taille maximale d'un fichier importé, en Mo (Cloudflare gratuit : 100 Mo maximum).
MAX_UPLOAD_MB=100

# Option A – Cloudflare Tunnel : jeton du tunnel (Zero Trust → Networks → Tunnels).
TUNNEL_TOKEN=

# Option B – Caddy : nom de domaine pointant vers votre IP publique.
DOMAIN=notes.mondomaine.fr
